{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allDigest"
  ],
  "schedule": ["on the first day of the month"],
  "timezone": "Europe/Berlin",
  "prCreation": "not-pending",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "labels": ["dependencies"],
  "separateMinorPatch": true,
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "postUpdateOptions": ["pnpmDedupe"],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "minimumReleaseAge": "3 days",
    "schedule": ["on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "prCreation": "immediate",
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "description": "Group npm minor updates (release age inherited from security:minimumReleaseAgeNpm)",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "groupName": "all minor dependencies",
      "groupSlug": "all-minor"
    },
    {
      "description": "Automerge npm patches, digests, and pins",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "digest", "pin"],
      "automerge": true
    },
    {
      "description": "GitHub Actions: 3-day release age, no automerge (no merge_group CI coverage)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "automerge": false,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Python (pip_requirements): 3-day release age, no automerge (no CI coverage for scripts/)",
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["patch", "minor", "pin"],
      "automerge": false,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Major updates: manual review, 7-day release age",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Astro core and integrations must move in lockstep (astro v7 requires @astrojs/mdx v7). Widens the built-in monorepo group to any @astrojs/* package, including ones outside withastro/astro.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["astro", "@astrojs/**"],
      "groupName": "astro monorepo"
    },
    {
      "description": "React runtime and its DefinitelyTyped types live in separate repos, so the built-in monorepo group misses @types/react. Keep them in one PR.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react monorepo"
    }
  ]
}
