---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '../components/ui/button';

const homeLink = buttonVariants({ size: 'lg' });
const projectsLink = buttonVariants({ variant: 'outline', size: 'lg' });
---

<Layout title="Page not found – Arash Kadkhodaei" description="This page does not exist.">
  <section class="min-h-svh flex items-center justify-center py-24">
    <div class="container mx-auto px-4 max-w-3xl text-center">
      <p class="font-mono text-secondary mb-4">404</p>
      <h1 class="text-4xl font-bold mb-4">Page not found</h1>
      <p class="text-muted-foreground text-lg mb-8">
        The page you are looking for does not exist or has moved.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class={homeLink}>
          Back to home
        </a>
        <a href="/projects" class={projectsLink}>
          View projects
        </a>
      </div>
    </div>
  </section>
</Layout>
