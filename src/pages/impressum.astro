---
import Layout from '../layouts/Layout.astro';
import LegalToggle from '../components/LegalToggle.astro';
import AddressBlock from '../components/AddressBlock.astro';
---

<Layout
  title="Impressum · Arash Kadkhodaei"
  description="Impressum und rechtliche Angaben für kadkhodaei.de — Legal notice for kadkhodaei.de"
  noindex
>
  <style is:global>
    #legal-content [data-lang="en"] { display: none; }
    html[data-legal-lang="en"] #legal-content [data-lang="de"] { display: none; }
    html[data-legal-lang="en"] #legal-content [data-lang="en"] { display: revert; }
  </style>

  <section class="py-24">
    <div class="container mx-auto px-4 max-w-3xl">
      <div class="text-center mb-12 animate-fade-up animate-delay-1">
        <p lang="en" class="text-sm font-mono text-secondary tracking-widest uppercase mb-2">Legal</p>
        <h1 lang="de" class="text-4xl font-bold mb-4">Impressum</h1>
        <div class="w-16 h-1 bg-linear-to-r from-primary to-secondary mx-auto rounded-full" />
      </div>

      <div class="animate-fade-up animate-delay-2">
        <LegalToggle />
      </div>

      <div id="legal-content" class="animate-fade-up animate-delay-3">

        <!-- ── GERMAN ── -->
        <div lang="de" data-lang="de" class="space-y-10 text-sm leading-relaxed text-foreground">

          <div>
            <h2 class="text-lg font-semibold mb-3 text-foreground">Anbieter</h2>
            <p class="text-muted-foreground">
              <AddressBlock lang="de" />
            </p>
          </div>

          <div>
            <h2 class="text-lg font-semibold mb-3 text-foreground">Kontakt</h2>
            <p class="text-muted-foreground">
              E-Mail: <a href="mailto:arash@kadkhodaei.de" class="text-primary hover:underline">arash@kadkhodaei.de</a>
            </p>
          </div>

          <div>
            <h2 class="text-lg font-semibold mb-3 text-foreground">Hinweis</h2>
            <p class="text-muted-foreground">
              Diese Website ist ein privates Angebot von Arash Kadkhodaei. Sie ist kein Angebot der Universität Freiburg; die
              Universität ist für ihre Inhalte nicht verantwortlich.
            </p>
          </div>

          <div>
            <h2 class="text-lg font-semibold mb-3 text-foreground">Urheberrecht</h2>
            <p class="text-muted-foreground">
              Texte, Bilder und Gestaltung dieser Website sind, soweit nicht anders gekennzeichnet, urheberrechtlich geschützt.
              Für verlinkte Software-Projekte gelten die jeweils dort angegebenen Lizenzen.
            </p>
          </div>

        </div>

        <!-- ── ENGLISH ── -->
        <div lang="en" data-lang="en" class="space-y-10 text-sm leading-relaxed text-foreground">

          <div>
            <h2 class="text-lg font-semibold mb-3 text-foreground">Provider</h2>
            <p class="text-muted-foreground">
              <AddressBlock lang="en" />
            </p>
          </div>

          <div>
            <h2 class="text-lg font-semibold mb-3 text-foreground">Contact</h2>
            <p class="text-muted-foreground">
              Email: <a href="mailto:arash@kadkhodaei.de" class="text-primary hover:underline">arash@kadkhodaei.de</a>
            </p>
          </div>

          <div>
            <h2 class="text-lg font-semibold mb-3 text-foreground">Note</h2>
            <p class="text-muted-foreground">
              This is a private website of Arash Kadkhodaei. It is not operated by the University of Freiburg, which is not
              responsible for its content.
            </p>
          </div>

          <div>
            <h2 class="text-lg font-semibold mb-3 text-foreground">Copyright</h2>
            <p class="text-muted-foreground">
              Unless stated otherwise, the texts, images and design of this website are protected by copyright. Linked software
              projects are subject to the licences stated there.
            </p>
            <p class="text-muted-foreground mt-3">
              This English version is provided for convenience; the German version is authoritative.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>
</Layout>
