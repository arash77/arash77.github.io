---
import Layout from '../layouts/Layout.astro';
import ProjectsGrid from '../components/ProjectsGrid';
import { getCollection } from 'astro:content';

const projectEntries = await getCollection('projects');
const projects = projectEntries
  .map((entry) => ({
    id: entry.id,
    ...entry.data,
  }))
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));

// C10: fetch merged PR count at build time. Falls back to '480+' on any failure.
//
// The fallback is a rounded floor rather than a precise figure on purpose: it
// renders whenever the API call fails, and a stale precise number would be
// visibly *wrong* rather than merely out of date. Raise it when it is no longer
// a floor -- the real count is checkable at the search URL below.
const FALLBACK_PR_COUNT = '480+';
let mergedPrCount: string = FALLBACK_PR_COUNT;

// Astro builds inside the Actions step, so a `::warning::` prefix promotes this
// to a run-summary annotation. Dependency PRs automerge, and a plain build-log
// line is invisible in that flow -- the number would silently sit at the
// fallback forever.
function warnBuild(message: string) {
  const prefix = process.env.GITHUB_ACTIONS ? '::warning::' : '';
  // Leading newline is required, not cosmetic: Astro writes its route line
  // without a trailing one, so this lands mid-line and Actions only parses a
  // workflow command that starts a line -- no newline, no annotation.
  console.log(`\n${prefix}[projects.astro] ${message}`);
}

if (import.meta.env.PROD) {
  try {
    const token = import.meta.env.GITHUB_TOKEN;
    const headers: HeadersInit = {
      'User-Agent': 'kadkhodaei.de-build',
      Accept: 'application/vnd.github+json',
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
    };

    // `is:public` is load-bearing, not decorative: issue search returns what
    // the caller can see, so an authenticated request would otherwise fold in
    // merged PRs from private repos and publish them as a public figure.
    const res = await fetch(
      'https://api.github.com/search/issues?q=author%3Aarash77+type%3Apr+is%3Amerged+is%3Apublic&per_page=1',
      { headers }
    );

    // Throw rather than branch, so every failure reports through one site.
    if (!res.ok) {
      // statusText is empty over HTTP/2, which api.github.com speaks; the
      // rate-limit header is what separates a throttled 403 from a denied one.
      const remaining = res.headers.get('x-ratelimit-remaining') ?? 'unknown';
      throw new Error(`search returned ${res.status} (rate-limit remaining: ${remaining})`);
    }

    const data: unknown = await res.json();
    const total = (data as { total_count?: unknown }).total_count;
    if (typeof total !== 'number') {
      // Without this, a shape change ships the string "undefined" to the page.
      throw new Error('search returned no numeric total_count');
    }
    mergedPrCount = String(total);
  } catch (err) {
    warnBuild(
      `GitHub PR count unavailable (${err instanceof Error ? err.message : String(err)}); using fallback ${FALLBACK_PR_COUNT}.`
    );
  }
} else {
  console.warn('[projects.astro] Skipping GitHub PR fetch in non-prod environment.');
}
---

<Layout
  title="Projects – Arash Kadkhodaei"
  description="Open-source contributions, bioinformatics tooling, Python projects, and Galaxy ecosystem work by Arash Kadkhodaei."
>
  <div class="pt-24 pb-16">
    <div class="container mx-auto px-4 max-w-6xl">
      <!-- Header -->
      <div class="text-center mb-8" style="animation: fade-up 0.7s ease both 0.05s;">
        <p class="text-sm font-mono text-secondary tracking-widest uppercase mb-2">
          What I've built &amp; contributed to
        </p>
        <h1 class="text-5xl font-bold mb-4">Projects &amp; Contributions</h1>
        <div class="w-16 h-1 bg-linear-to-r from-primary to-secondary mx-auto rounded-full mb-6" />
        <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
          A collection of my open-source contributions, personal projects, and work across the
          Galaxy bioinformatics ecosystem and beyond.
        </p>
      </div>

      <!-- Stats bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
        {[
          { label: 'Projects', value: projects.length, delay: '0.3s' },
          { label: 'Featured', value: projects.filter((p) => p.featured).length, delay: '0.45s' },
          { label: 'Categories', value: new Set(projects.map((p) => p.category)).size, delay: '0.6s' },
          { label: 'GitHub PRs', value: mergedPrCount, delay: '0.75s' },
        ].map(({ label, value, delay }) => (
          <div class="text-center p-5 rounded-xl bg-card border border-border" style={`animation: fade-up 0.5s ease both ${delay};`}>
            <p class="text-3xl font-bold text-primary">{value}</p>
            <p class="text-sm text-muted-foreground font-mono mt-1">{label}</p>
          </div>
        ))}
      </div>

      <!-- Interactive grid (React island) -->
      <ProjectsGrid projects={projects} client:load />
    </div>
  </div>
</Layout>
